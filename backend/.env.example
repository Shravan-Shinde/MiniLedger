# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://miniledger:miniledger_dev_password@localhost:5432/miniledger?schema=public"

# JWT Secret Key (must be at least 24 characters)
JWT_SECRET="replace-with-a-secure-random-secret-key-of-at-least-24-characters"

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# OTP Security Settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# CORS Allowed Origins
CORS_ORIGIN=*
