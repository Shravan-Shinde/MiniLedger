# MiniLedger Mobile Environment Configuration
# After editing this file, restart Expo with: npx expo start --clear

# 1. For Android Emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# 2. For iOS Simulator / Web:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api

# 3. For Physical Android / iOS Device via Expo Go:
# Replace with your development machine's local Wi-Fi / LAN IP (e.g., http://192.168.1.15:5000/api):
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000/api
